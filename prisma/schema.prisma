generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CV {
  id              String   @id @default(cuid())

  // Candidate details
  fullName        String
  email           String
  phone           String?
  domain          String   // The candidate's profession (shown as "Profession" in the UI)
  experienceYears Int?
  currentRole     String?
  currentCompany  String?
  education       String?  // free text: field of study, institution, year
  skills          String?  // free-text, comma separated
  city            String?  // shown as "Location" in the UI
  notes           String?  // internal notes BK can add later

  // Segregation fields. Nullable so CVs submitted before these existed stay valid.
  industry        String?
  degree          String?  // qualification level, e.g. "Bachelor's degree"
  gender          String?
  age             Int?
  pwd             Boolean  @default(false) // person with a disability

  // Uploaded file (stored in a private Vercel Blob store).
  // filePathname is what's passed to the Blob SDK's get() to read the file back --
  // fileUrl is not publicly fetchable and is kept only for reference/debugging.
  fileUrl         String
  filePathname    String   @default("")
  fileName        String
  fileSize        Int?
  fileType        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([domain])
  @@index([industry])
  @@index([degree])
  @@index([gender])
  @@index([age])
  @@index([pwd])
  @@index([createdAt])
  @@index([fullName])
}

// Single-row table holding the admin password hash (id is always "admin").
// While this table is empty, the ADMIN_PASSWORD environment variable is used.
model AdminSettings {
  id           String   @id @default("admin")
  passwordHash String
  updatedAt    DateTime @updatedAt
}
